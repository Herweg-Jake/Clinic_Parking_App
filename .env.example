# Database Configuration
# For local development with PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_parking?schema=public"

# For production (Supabase example)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Stripe Configuration
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Twilio SMS Configuration
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# Cron Job Secret
# Generate a random string and set the same value in Vercel env vars
# Used to authenticate the /api/cron/notifications endpoint
CRON_SECRET="your_random_cron_secret_here"

# App Configuration
# IMPORTANT: Update this to your production URL when deploying (e.g., https://yourapp.vercel.app)
# All SMS links (status, extend, checkin) use this value — leaving it as localhost will break SMS for real users
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional: Supabase Configuration (if using Supabase Auth)
# Get these from your Supabase project settings
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
