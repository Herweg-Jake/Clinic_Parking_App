generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  pending
  approved_pt
  paid
  expired
  void
}

enum PermitKind {
  appointment
  staff
  long_term
}

model Vehicle {
  id           String    @id @default(cuid())
  licensePlate String    @unique // normalized: uppercase, no spaces
  ownerEmail   String?
  ownerPhone   String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  permits      Permit[]

  @@index([licensePlate])
}

model Spot {
  id       String    @id @default(cuid())
  label    String    @unique // e.g. A1..A20
  isActive Boolean   @default(true)
  sessions Session[]
}

model Session {
  id        String        @id @default(cuid())
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  vehicleId String
  spot      Spot          @relation(fields: [spotId], references: [id])
  spotId    String
  startedAt DateTime      @default(now())
  expiresAt DateTime?
  status    SessionStatus @default(pending)
  source    String // "pt_whitelist" | "visitor_payment" | "nevada_pt_code" | "manual_admin"

  // 1:1 relation to Payment (single FK on Session)
  payment   Payment? @relation(name: "SessionPayment", fields: [paymentId], references: [id])
  paymentId String?  @unique

  notes String?

  // Notification tracking for SMS reminders
  phoneNumber        String?   // Denormalized for quick notification access
  notificationSentAt DateTime? // When expiration warning was sent

  @@index([status, expiresAt])
  @@index([vehicleId, startedAt])
  @@index([spotId, startedAt])
}

model Payment {
  id                      String    @id @default(cuid())
  stripeCheckoutSessionId String    @unique
  amountCents             Int
  currency                String    @default("usd")
  status                  String // "initiated" | "paid" | "failed" | "refunded"
  paidAt                  DateTime?

  // back-relation (no extra FK here)
  session Session? @relation(name: "SessionPayment")
}

model Permit {
  id        String     @id @default(cuid())
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  vehicleId String
  kind      PermitKind
  validFrom DateTime
  validTo   DateTime
  meta      Json?

  @@index([vehicleId, validFrom, validTo])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String // "admin" | "attendant" | "read_only"
  createdAt DateTime @default(now())
}

model Config {
  key       String   @id // e.g. "rate_cents", "duration_minutes", "grace_minutes"
  value     String
  updatedAt DateTime @default(now())
}

model ExtensionToken {
  id        String   @id @default(cuid())
  token     String   @unique // Random token for URL
  sessionId String   // Reference to session (not FK to allow session deletion)
  expiresAt DateTime // Token expiration (30 min from creation)
  usedAt    DateTime? // When token was used (null if unused)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([sessionId])
}

model Ticket {
  id          String    @id @default(cuid())
  code        String    @unique // e.g. "TKT-001"
  plate       String    // license plate (normalized)
  spot        String    // spot label e.g. "A5"
  amountCents Int       // fine amount in cents
  notes       String?   // optional officer notes
  issuedBy    String    // admin user email who issued it (auth identity)
  citedBy     String?   // name of officer/staff who physically wrote the ticket
  issuedAt    DateTime  @default(now())
  paidAt      DateTime? // null until paid

  @@index([code])
  @@index([plate])
}

model Business {
  id              String       @id @default(cuid())
  name            String
  code            String       @unique // validation code shared with the business
  contactEmail    String?
  contactPhone    String?
  monthlyFeeCents Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  validations     Validation[]

  @@index([code])
}

model Validation {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  plate       String?
  spot        String?
  sessionId   String?
  hours       Int      @default(1)
  validatedBy String? // admin email if performed via admin UI
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([sessionId])
}

model TicketCounter {
  id    String @id @default("singleton")
  count Int    @default(0)
}
